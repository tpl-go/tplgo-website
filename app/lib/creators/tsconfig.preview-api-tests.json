{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": "../../..",
    "paths": {
      "@/*": ["*"]
    },
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "strict": true,
    "rootDir": "../../..",
    "outDir": "../../../.tmp/creator-preview-api-tests",
    "noEmit": false
  },
  "include": [
    "./*.ts",
    "../../components/creators/workspace/**/*.tsx",
    "../../components/admin/creators/**/*.tsx",
    "../../creator/**/*.tsx",
    "../../admin/creators/**/*.tsx",
    "../../api/creators/**/*.ts",
    "../../api/v1/creators/**/*.ts",
    "../../api/v1/creator/**/*.ts"
  ]
}
