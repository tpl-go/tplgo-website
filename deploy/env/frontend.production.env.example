# Copy to .env.production.local on the deployment server.
# Do not commit real production secrets or domain-specific private values.

NEXT_PUBLIC_TPL_API_BASE_URL=https://api.tplgo.com
NEXT_PUBLIC_SITE_URL=https://tplgo.com
NEXT_PUBLIC_TPL_APP_BASE_URL=https://tplgo.com

# Preserve mock/local checkout for the first deployment.
NEXT_PUBLIC_TPL_USE_BACKEND_CHECKOUT=false
NEXT_PUBLIC_TPL_BACKEND_CHECKOUT_SERVICES=
NEXT_PUBLIC_TPL_BACKEND_FALLBACK_TO_LOCAL=true
NEXT_PUBLIC_TPL_DEBUG_BACKEND_PAYLOADS=false
