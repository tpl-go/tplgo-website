# Copy to tpl-api/.env on the deployment server.
# Do not commit real production secrets.

NODE_ENV=production
PORT=4000
HOST=0.0.0.0
APP_BASE_URL=https://tplgo.com
API_BASE_URL=https://api.tplgo.com
CORS_ORIGINS=http://localhost:3000,https://tplgo.com,https://www.tplgo.com
LOG_LEVEL=info

DATABASE_URL=postgres://tpl_user:REPLACE_WITH_STRONG_PASSWORD@127.0.0.1:5432/tpl
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10

SESSION_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
SESSION_COOKIE_NAME=tpl_api_session
SESSION_TTL_SECONDS=2592000
OTP_PROVIDER=mock
OTP_DELIVERY_CHANNEL=sms
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_DEVELOPMENT_RESPONSE_ENABLED=false

# Keep payment and suppliers in safe mock/provider-disabled mode.
PAYMENT_GATEWAY=mock
PROVIDERS_ENABLED=false
PROVIDERS_DRY_RUN=true
PROVIDER_REQUEST_TIMEOUT_MS=5000
PROVIDER_RETRY_ATTEMPTS=0
PROVIDER_RETRY_BACKOFF_MS=250
PROVIDER_CIRCUIT_BREAKER_ENABLED=false

# Keep Redis and queues disabled unless the server is verified.
REDIS_ENABLED=false
REDIS_URL=
QUEUE_ENABLED=false
QUEUE_REDIS_URL=

# Admin production auth. Do not use dev auth in production.
ADMIN_AUTH_MODE=password
ADMIN_SESSION_TTL_SECONDS=43200
ADMIN_DEV_LOGIN_ENABLED=false
ADMIN_PASSWORD_PEPPER=REPLACE_WITH_STRONG_RANDOM_SECRET
ADMIN_MFA_SECRET_ENCRYPTION_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
ADMIN_SSO_ENABLED=false
ADMIN_SSO_PROVIDER=none
ADMIN_SSO_ALLOWED_DOMAINS=
ADMIN_SSO_REQUIRE_VERIFIED_EMAIL=true
ADMIN_SSO_STATE_TTL_SECONDS=600
ADMIN_SSO_PKCE_REQUIRED=true

# Optional providers must remain empty until explicitly approved.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
FIREBASE_OTP_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_AUTH_EMULATOR_HOST=
MSG91_OTP_ENABLED=false
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_BASE_URL=https://control.msg91.com
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
